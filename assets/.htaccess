# Prevent directory listing.
Options -Indexes

# Block PHP and related script execution in this directory.
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phps|phar)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
